# Serin PMS - environment
# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Postgres 14+ is required. The double-booking guarantee is an
# EXCLUDE USING gist constraint that no other engine provides.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses row-level security - never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Direct connection, used by migrations only.
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# ---------------------------------------------------------------------------
# Storage buckets
# ---------------------------------------------------------------------------
# Payment proofs and receipts contain guest names and partial account numbers.
# PRIVATE bucket, signed URLs only. Never public.
SUPABASE_BUCKET_PAYMENT_PROOFS=payment-proofs
SUPABASE_BUCKET_RECEIPTS=receipts
# Unit photos and task photos may be public.
SUPABASE_BUCKET_UNIT_PHOTOS=unit-photos
SUPABASE_BUCKET_TASK_PHOTOS=task-photos

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Serin Tagaytay <bookings@example.com>"
OWNER_ALERT_EMAIL=

# ---------------------------------------------------------------------------
# Background jobs
# ---------------------------------------------------------------------------
# Shared secret. Every cron route must check this header before doing work,
# or anyone can trigger a sync or expire holds.
CRON_SECRET=

# NOTE: Vercel Hobby allows 2 cron jobs at once-per-day. The 30-minute iCal
# sync requires Vercel Pro, or an external scheduler hitting the route with
# the secret above. See DECISIONS.md.

# ---------------------------------------------------------------------------
# Booking rules
# ---------------------------------------------------------------------------
# Hours a pending booking holds its dates before auto-cancelling.
HOLD_DURATION_HOURS=12
HOLD_REMINDER_HOURS=6

# OPEN QUESTION - the single most important unanswered number. The whole
# payment flow depends on it. Do not guess.
DEFAULT_RESERVATION_FEE_PHP=

# ---------------------------------------------------------------------------
# Payment instructions shown to guests
# ---------------------------------------------------------------------------
GCASH_NAME=
GCASH_NUMBER=
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
TZ=Asia/Manila

# ---------------------------------------------------------------------------
# Admin auth
# ---------------------------------------------------------------------------
# Password for the /login page. Set any strong password.
# Without this, the login endpoint returns 500.
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# AI Marketing Assistant (Anthropic Claude)
# ---------------------------------------------------------------------------
# Get your key at https://console.anthropic.com/settings/keys
# Powers the AI marketing assistant in the admin panel
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Facebook Messenger bot
# ---------------------------------------------------------------------------
# developers.facebook.com > your app > Messenger > Settings > Access Tokens
# > (Page name) > Generate. Lets the bot send replies via the Send API.
FB_PAGE_ACCESS_TOKEN=

# Any random string you invent. Must match the "Verify Token" you type into
# the webhook setup screen in the Meta dashboard - it's how Meta confirms
# this server is really yours during the handshake.
FB_VERIFY_TOKEN=

# Settings > Basic > App Secret. Used to verify that incoming webhook
# requests really came from Meta (HMAC signature check), not a spoofed
# request pretending to be one.
FB_APP_SECRET=
